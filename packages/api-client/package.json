{
  "name": "@schoolcoin/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./mock/engine": "./src/mock/engine.ts"
  },
  "scripts": {
    "generate": "curl -sf http://localhost:4000/docs-json -o openapi.json && openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@schoolcoin/mock-data": "workspace:*",
    "@schoolcoin/types": "workspace:*",
    "openapi-fetch": "^0.13.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19"
  },
  "devDependencies": {
    "@schoolcoin/config": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.4.4",
    "react": "19.1.1",
    "typescript": "^5.7.2"
  }
}
