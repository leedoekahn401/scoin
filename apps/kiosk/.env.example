# "mock" = everything runs in the browser on seed data (default).
# "http" = call a real API (the NestJS backend, or `pnpm dev:mock-api`).
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Show demo accounts, the card-scan simulator and "simulate transfer".
NEXT_PUBLIC_DEMO_TOOLS=1
