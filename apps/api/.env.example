PORT=4000
NODE_ENV=development

# If docker compose runs with POSTGRES_PORT=5433, use :5433 here.
DATABASE_URL=postgresql://schoolcoin:schoolcoin@localhost:5432/schoolcoin?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated list of front-end origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# SePay (see docs/sepay-setup.md)
SEPAY_API_KEY=change-me
SEPAY_BANK_ACCOUNT=0000000000
SEPAY_BANK_CODE=MBBank

# Mail (Mailpit in dev: inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="SchoolCoin <no-reply@schoolcoin.local>"
