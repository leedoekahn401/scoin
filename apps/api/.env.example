PORT=4000
NODE_ENV=development

# If docker compose runs with POSTGRES_PORT=5433, use :5433 here.
DATABASE_URL=postgresql://schoolcoin:schoolcoin@localhost:5432/schoolcoin?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Comma-separated front-end origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Used in email links (password reset, top-up receipts)
PARENT_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3004

# SePay (docs/sepay-setup.md). The webhook sends "Authorization: Apikey <SEPAY_WEBHOOK_KEY>".
SEPAY_WEBHOOK_KEY=change-me
# School bank account shown on the VietQR (B6). SCHOOL_BANK_NAME is the SePay bank code, e.g. MBBank.
SCHOOL_BANK_NAME=MBBank
SCHOOL_BANK_ACCOUNT=0000000000
SCHOOL_BANK_HOLDER=TRUONG THCS DEMO

# Student photos and menu images, served at /uploads
UPLOAD_DIR=./uploads

# Mail (Mailpit in dev: inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="SchoolCoin <no-reply@schoolcoin.local>"

# Dev/demo only: the seeded kiosk device uses this key (apps/kiosk NEXT_PUBLIC_KIOSK_KEY must match).
SEED_KIOSK_KEY=dev-kiosk-key-change-me
