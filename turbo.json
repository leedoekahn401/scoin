{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_API_MODE",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_DEMO_TOOLS",
    "NEXT_PUBLIC_KIOSK_DEVICE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_OUTPUT", "NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@schoolcoin/admin#typecheck": { "dependsOn": ["^build", "build"] },
    "@schoolcoin/pos#typecheck": { "dependsOn": ["^build", "build"] },
    "@schoolcoin/parent#typecheck": { "dependsOn": ["^build", "build"] },
    "@schoolcoin/kiosk#typecheck": { "dependsOn": ["^build", "build"] },
    "test": {
      "dependsOn": ["^build"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    }
  }
}
